{
  "name": "@starlane/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/backend/src/server/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "tsx src/simulation.ts",
    "play:console": "tsx src/simulation/human.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@starlane/shared": "*",
    "dotenv": "^16.6.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6",
    "vitest": "^4.1.11"
  }
}
