generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum GameMode {
  SOLO_AI
  ONE_VS_ONE
  TWO_VS_TWO
  FOUR_PLAYER_FFA
}
model User {
  id        String   @id @default(uuid())
  nickname  String
  rp        Int      @default(1000)
  createdAt DateTime @default(now())
}
// Persistence contract for a future repository adapter. Live matches currently stay in memory.
model Match {
  id         String   @id @default(uuid())
  mode       GameMode
  status     String
  snapshot   Json
  revision   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
// Atomic per-user feature aggregate: inventory, event wallets, claims, participation and history.
// Kept separate from in-match money and the GameEngine snapshot.
model EventAccount {
  userId    String   @id
  state     Json
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}
