{
    servers {
        timeouts {
            read_header 10s
            read_body 30s
            idle 60s
        }
    }
}
{$NETSEC_DOMAIN} {
    request_body {
        max_size 1MB
    }
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy api:8890 {
        header_up Host {host}
        header_up -X-Forwarded-For
        header_up X-Real-IP {remote_host}
    }
}
