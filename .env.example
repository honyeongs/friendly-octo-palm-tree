# Core monitoring works with no external credentials.
NETSEC_DB=data/netsec.sqlite3
NETSEC_ORIGIN=http://127.0.0.1:8890
NETSEC_SESSION_HOURS=8
NETSEC_RETENTION_DAYS=30

# Optional generic HTTPS webhook. Blank means disabled.
NETSEC_WEBHOOK_URL=
NETSEC_WEBHOOK_TOKEN=

# Optional SMTP email. Blank host/from means disabled.
NETSEC_SMTP_HOST=
NETSEC_SMTP_PORT=587
NETSEC_SMTP_USER=
NETSEC_SMTP_PASSWORD=
NETSEC_SMTP_FROM=
NETSEC_SMTP_TLS=starttls

# Only needed in the sample app / agent process. Create in Sources, not here.
NETSEC_SOURCE_KEY=
# Optional SaaS: defaults remain a local, non-charging demonstration.
NETSEC_SAAS_ENABLED=0
NETSEC_DATABASE_URL=
NETSEC_ENCRYPTION_KEY=
NETSEC_MAIL_MODE=local
NETSEC_BILLING_MODE=mock
NETSEC_STRIPE_KEY=
NETSEC_STRIPE_WEBHOOK_SECRET=
NETSEC_STRIPE_PRICES={}
NETSEC_LAUNCH_CONFIRMED=0
NETSEC_TERMS_VERSION=draft-1
NETSEC_TERMS_URL=
NETSEC_PRIVACY_URL=
NETSEC_OIDC_ISSUERS=
NETSEC_WEBHOOK_HOSTS=
NETSEC_EMBEDDED_WORKER=1
NETSEC_STALE_MINUTES=15
NETSEC_RESTORE_DATABASE_URL=
POSTGRES_PASSWORD=
NETSEC_DOMAIN=
NETSEC_TRUSTED_PROXIES=
